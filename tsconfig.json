{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "esModuleInterop": true,
        "rootDir": "./src",
        "outDir": "./lib/src",
        "target": "ES2017",
        "declaration": true,
        "sourceMap": true,
        "noEmitOnError": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "useUnknownInCatchVariables": false
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "lib",
        "**/*.spec.ts"
    ]
}
