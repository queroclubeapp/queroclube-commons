{
  "name": "@queroclube/queroclube-commons",
  "version": "1.0.1",
  "description": "commons utils",
  "main": "lib/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "compile": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test-live": "jest --watchAll",
    "tag": "git tag $(node -p \"require('./package.json').version\")",
    "preinstall": "aws codeartifact login --tool npm --repository linkgourmet --domain linkgourmet --domain-owner 281910127800 --region us-east-1"
  },
  "author": "Jefferson Block",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-pinpoint": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/client-ses": "^3.758.0",
    "@aws-sdk/client-sns": "^3.758.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@google-cloud/local-auth": "^2.1.1",
    "@types/uuid": "^9.0.6",
    "class-validator": "^0.14.0",
    "googleapis": "^105.0.0",
    "moment": "^2.29.4",
    "string-mask": "^0.3.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "concurrently": "^8.2.1",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
